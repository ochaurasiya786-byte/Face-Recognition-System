# ==========================================
# Face Recognition Attendance - Environment Configuration
# ==========================================

# MySQL Database Configuration
# In production on Render, connect to a cloud MySQL database (TiDB Cloud, Aiven, Clever Cloud, etc.)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=student
DB_PORT=3306
# Optional SSL Certificate path for cloud databases:
# DB_SSL_CA=ca.pem

# Gmail SMTP Configuration for Action Notifications
ADMIN_EMAIL=admin@example.com
SMTP_EMAIL=admin@example.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Render / Backend Public URL (Set to your Render URL when hosted, e.g. https://your-service.onrender.com)
BASE_URL=https://your-service.onrender.com

# Cryptographic Secret for Email Action Tokens
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Polling Interval (in seconds) for Admin Panel
POLL_SECONDS=30

